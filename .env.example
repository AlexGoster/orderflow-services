# Скопируйте в .env и заполните. .env никогда не коммитится.
# В docker-compose эти переменные задаются отдельно для каждого сервиса,
# здесь — пример значений для запуска одного сервиса на хосте.

# БД каждого сервиса — своя (собственная схема, никакого шаринга таблиц)
DATABASE_URL=postgresql+asyncpg://orderflow:orderflow@localhost:5432/order_db

# Шина событий (Redis pub/sub)
BUS_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# Адреса соседних сервисов для прямых REST-вызовов
CATALOG_SERVICE_URL=http://localhost:8001
ORDER_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_URL=http://localhost:8003

# Устойчивость вызовов order -> catalog
CATALOG_MAX_ATTEMPTS=3
CATALOG_FAILURE_THRESHOLD=3
CATALOG_RECOVERY_TIMEOUT=30
CATALOG_TIMEOUT=3.0
